# Google Cloud API key with the "Places API" enabled.
# Keep this server-side only — never expose it in frontend code.
GOOGLE_PLACES_API_KEY=

# Anthropic API key (console.anthropic.com). Optional: without it, search falls
# back to the built-in regex query parser and review miner.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for query parsing and review summaries.
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5
# ANTHROPIC_NUTRITION_MODEL=claude-sonnet-5-5
